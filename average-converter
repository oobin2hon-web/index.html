<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SOLDOUT2 アベレージ自動変換</title>
<style>
* {
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
    margin: 0;
    padding: 12px;
    background: #f5f5f5;
    color: #222;
}

.container {
    max-width: 700px;
    margin: auto;
}

/* ヘッダー・戻るボタン */
.header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.back-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    background: #e0e0e0;
    color: #333;
    text-decoration: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: bold;
}

.back-btn:hover {
    background: #d0d0d0;
}

h1 {
    font-size: 20px;
    margin: 0;
    text-align: center;
    flex-grow: 1;
}

h2 {
    font-size: 16px;
    margin-top: 0;
    margin-bottom: 8px;
}

.description {
    color: #666;
    font-size: 13px;
    margin-bottom: 12px;
    text-align: center;
}

.card {
    background: white;
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}

textarea {
    width: 100%;
    height: 180px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 13px;
    font-family: monospace;
    resize: vertical;
}

button {
    border: none;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
    cursor: pointer;
    font-weight: bold;
}

.convert-btn {
    background: #1976d2;
    color: white;
    width: 100%;
    margin-top: 8px;
}

.clear-btn {
    background: #eee;
    color: #333;
    width: 100%;
    margin-top: 6px;
}

.copy-btn {
    background: #4caf50;
    color: white;
    width: 100%;
    margin-top: 8px;
}

.result-area {
    background: #f9f9f9;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #e0e0e0;
    white-space: pre-wrap;
    word-break: break-all;
    font-family: monospace;
    font-size: 13px;
    min-height: 100px;
}
</style>
</head>
<body>

<div class="container">

    <div class="header-bar">
        <a href="index.html" class="back-btn">← 戻る</a>
        <h1>アベレージ自動変換</h1>
        <div style="width: 60px;"></div>
    </div>

    <div class="description">
        テキストを入力して変換ボタンを押すと、アベレージ表記等を整形・変換します。
    </div>

    <div class="card">
        <h2>変換前テキスト</h2>
        <textarea id="inputText" placeholder="ここにテキストを貼り付けてください..."></textarea>
        <button class="convert-btn" onclick="convertText()">変換する</button>
        <button class="clear-btn" onclick="clearText()">クリア</button>
    </div>

    <div class="card">
        <h2>変換結果</h2>
        <div id="resultText" class="result-area">ここに変換結果が表示されます。</div>
        <button class="copy-btn" onclick="copyResult()">結果をコピー</button>
    </div>

</div>

<script>
function convertText() {
    const input = document.getElementById("inputText").value;
    if (!input.trim()) {
        document.getElementById("resultText").innerText = "テキストを入力してください。";
        return;
    }

    // ここに任意の変換ロジックを実装します（例: 空白・改行の整形処理等）
    let converted = input;

    document.getElementById("resultText").innerText = converted;
}

function clearText() {
    document.getElementById("inputText").value = "";
    document.getElementById("resultText").innerText = "ここに変換結果が表示されます。";
}

function copyResult() {
    const result = document.getElementById("resultText").innerText;
    if (!result || result === "ここに変換結果が表示されます。") return;

    navigator.clipboard.writeText(result).then(() => {
        alert("コピーしました！");
    }).catch(err => {
        alert("コピーに失敗しました。");
    });
}
</script>

</body>
</html>
